---
import {settings} from '../lib/catalog';
import {text} from '../lib/i18n';
import type {Design,Locale} from '../lib/types';

interface Props { reviews:Design['reviews']; lang:Locale; }
const {reviews,lang}=Astro.props;
const profiles=[
  {platform:'Instagram',handle:settings.instagram,url:`https://www.instagram.com/${settings.instagram}/`},
  {platform:'Threads',handle:settings.threads,url:`https://www.threads.com/@${settings.threads}`},
];
const platformFor=(url:string)=>new URL(url).hostname.replace(/^www\./,'')==='instagram.com'?'Instagram':'Threads';
---
<section class="section-wrap design-posts" aria-labelledby="design-posts-heading">
  <div class="section-heading">
    <div><span class="eyebrow">SEEN & SHARED</span><h2 id="design-posts-heading">{text(lang,'착용 모습 & 관련 게시물','See it worn & related posts')}</h2></div>
    <p>{text(lang,'실루엣과 디테일, 실제 착용 모습을\n인스타그램과 Threads에서 만나보세요.','Explore the silhouette, details and real-life styling\non Instagram and Threads.')}</p>
  </div>
  {reviews.length>0?<>
    <div class="social-post-grid">{reviews.map(review=><a class="social-post-card" href={review.url} target="_blank" rel="noopener noreferrer">
      <span class="eyebrow">{platformFor(review.url)}</span>
      <h3>{review.label[lang]}</h3>
      <span class="social-post-action">{text(lang,'게시물 보기','View post')} <span aria-hidden="true">↗</span></span>
    </a>)}</div>
    <div class="social-profile-links">{profiles.map(profile=><a class="text-link" href={profile.url} target="_blank" rel="noopener noreferrer">{profile.platform} @{profile.handle} ↗</a>)}</div>
  </>:<>
    <p class="social-post-empty">{text(lang,'이 디자인의 게시물은 준비 중이에요. 미셸의 채널에서 더 많은 스타일을 먼저 만나보세요.','Posts for this design are coming soon. Explore more styles on Michelle’s profiles in the meantime.')}</p>
    <div class="social-post-grid">{profiles.map(profile=><a class="social-post-card profile-card" href={profile.url} target="_blank" rel="noopener noreferrer">
      <span class="eyebrow">MICHELLE ON {profile.platform.toUpperCase()}</span>
      <h3>{profile.platform}</h3>
      <span class="social-profile-handle">@{profile.handle}</span>
      <span class="social-post-action">{text(lang,'프로필 보기','View profile')} <span aria-hidden="true">↗</span></span>
    </a>)}</div>
  </>}
</section>
