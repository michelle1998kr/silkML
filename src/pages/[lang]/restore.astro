---
import Layout from '../../layouts/Layout.astro';
import Restore from '../../components/Restore';
import {getCatalog} from '../../lib/catalog';
import {locales,text} from '../../lib/i18n';
import type {Locale} from '../../lib/types';
export function getStaticPaths(){return locales.map(lang=>({params:{lang}}));}
const lang=Astro.params.lang as Locale;const catalog=await getCatalog();
---
<Layout lang={lang} title={text(lang,'선택 불러오기','Restore selections')}><div class="section-wrap page-intro"><span class="eyebrow">WELCOME BACK</span><h1>{text(lang,'취향을 이어서','Pick up where you left off')}</h1></div><section class="section-wrap restore-page"><Restore catalog={catalog} lang={lang} client:load/></section></Layout>
