---
import Layout from '../../layouts/Layout.astro';
import {locales,text} from '../../lib/i18n';
import type {Locale} from '../../lib/types';
export function getStaticPaths(){return locales.map(lang=>({params:{lang}}));}
const lang=Astro.params.lang as Locale;
---
<Layout lang={lang} title={text(lang,'저장 정보 안내','Your saved information')}><article class="section-wrap prose-page"><span class="eyebrow">YOUR INFORMATION</span><h1>{text(lang,'선택은 남기고, 정보는 내 손에.','Your choices. Your information.')}</h1><h2>{text(lang,'선택과 아이템 메모','Selections and item notes')}</h2><p>{text(lang,'디자인, 실크, 컬러, 수량과 아이템 메모는 이 브라우저에 저장됩니다. 서버에 고객 정보를 저장하지 않습니다. 다른 브라우저나 기기에서는 자동으로 동기화되지 않으며, 브라우저 설정이나 데이터 정리로 삭제될 수 있습니다.','Designs, silks, colors, quantities and item notes are saved in this browser. We do not store customer information on a server. Choices do not automatically sync between browsers or devices and may be removed by browser settings or data cleanup.')}</p><h2>{text(lang,'신체 치수와 제안서','Measurements and proposals')}</h2><p>{text(lang,'치수는 현재 탭의 세션에 저장됩니다. 탭을 닫으면 보통 삭제되지만 브라우저의 세션 복원 기능으로 유지될 수 있습니다. 제안서는 직접 복사하거나 이미지를 다운로드하고, 인스타그램에서 직접 전송할 때만 외부로 전달됩니다. 다운로드한 이미지와 클립보드에는 입력한 치수와 메모가 포함됩니다.','Measurements are stored in the current tab session. They normally disappear when the tab closes, though browser session restoration may retain them. You choose when to copy, download or send the proposal through Instagram. Downloaded images and copied text contain your measurements and notes.')}</p><h2>{text(lang,'복구 링크','Recovery links')}</h2><p>{text(lang,'복구 링크에는 디자인, 실크, 컬러, 수량만 포함됩니다. 메모와 신체 치수는 포함되지 않습니다. 링크를 가진 사람은 선택을 볼 수 있습니다.','A recovery link contains only designs, silks, colors and quantities. It excludes notes and measurements. Anyone with the link can view the selection.')}</p><h2>{text(lang,'외부 링크','External links')}</h2><p>{text(lang,'인스타그램과 Threads 링크를 열면 해당 서비스의 정책과 설정이 적용됩니다. 이 사이트는 광고 추적기나 소셜 미디어 임베드를 사용하지 않습니다. 호스팅 서비스는 사이트 제공을 위해 일반적인 접속 정보를 처리할 수 있습니다.','Instagram and Threads have their own policies and settings. This site does not use advertising trackers or embedded social feeds. The hosting provider may process ordinary connection information to serve the website.')}</p><button type="button" class="button secondary" id="clear-data">{text(lang,'이 브라우저의 선택과 치수 삭제','Clear selections and measurements in this browser')}</button><p id="clear-status" role="status"></p></article><script>
import {CART_KEY,MEASUREMENTS_KEY} from '../../lib/shop';
const button=document.querySelector<HTMLButtonElement>('#clear-data');
button?.addEventListener('click',()=>{const ko=document.documentElement.lang==='ko';if(!confirm(ko?'저장된 선택, 메모, 현재 탭의 치수를 삭제할까요?':'Clear saved selections, notes and measurements in this tab?'))return;try{localStorage.removeItem(CART_KEY);sessionStorage.removeItem(MEASUREMENTS_KEY);window.dispatchEvent(new CustomEvent('michelle:cart',{detail:{count:0}}));document.querySelector('#clear-status')!.textContent=ko?'삭제했어요. 다른 탭의 치수는 해당 탭에서 삭제해 주세요.':'Cleared. Measurements in other tabs must be cleared in those tabs.';}catch{document.querySelector('#clear-status')!.textContent=ko?'브라우저 설정에서 사이트 데이터를 삭제해 주세요.':'Please clear site data through your browser settings.';}});
</script></Layout>
